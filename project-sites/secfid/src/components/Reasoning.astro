---
import { reasoning, reasoningAverage } from '../data/results.js';

const W = 560, H = 360;
const ml = 44, mr = 14, mt = 14, mb = 40;
const pw = W - ml - mr, ph = H - mt - mb;
const X = (s) => ml + ((s - 45) / 50) * pw;
const Y = (f) => mt + ((95 - f) / 40) * ph;
const xticks = [50, 60, 70, 80, 90];
const yticks = [60, 70, 80, 90];

const makeLine = (series) => ({
  label: series.label,
  d: series.path.map(([s, f], i) => `${i ? 'L' : 'M'} ${X(s).toFixed(1)} ${Y(f).toFixed(1)}`).join(' '),
  points: series.path.map(([s, f]) => [X(s), Y(f)]),
  tip: `${series.label} | security ${series.path[0][0]}% to ${series.path[3][0]}% | fidelity ${series.path[0][1]}% to ${series.path[3][1]}%`,
});

const lines = reasoning.map(makeLine);
const average = makeLine(reasoningAverage);
---

<section class="section-rule" id="reasoning">
  <div class="wrap split">
    <div class="split-copy">
      <h2>More reasoning improves security, not fidelity</h2>
      <p class="prose">
        Adding reasoning effort improves security but leaves fidelity mostly
        unchanged. Compared with matched baselines, low, medium, and high reasoning
        raise average security by <strong>6.3, 9.1, and 12.6 points</strong>.
        Fidelity changes by <strong>-1.3, -0.7, and -0.9 points</strong>.
      </p>
      <p class="prose">
        Longer reasoning helps models refuse the injected instruction. It does not
        help them preserve suspicious text as data. The average trajectory moves
        right, not up, so <strong>the tradeoff remains</strong>.
      </p>
    </div>

    <figure class="plate reveal">
      <div class="rchart" data-reason-chart>
        <svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" font-family="IBM Plex Mono, monospace" role="img" aria-labelledby="reason-title reason-desc">
          <title id="reason-title">Security and fidelity trajectories as model reasoning increases</title>
          <desc id="reason-desc">Seven model trajectories are muted. Their average is emphasized and moves toward greater security with nearly unchanged fidelity.</desc>
          <defs>
            <marker id="arr" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 0 L 8 4 L 0 8 z" fill="var(--ink-faint)" />
            </marker>
            <marker id="avg-arr" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 8 4 L 0 8 z" fill="var(--ink)" />
            </marker>
          </defs>
          {xticks.map((t) => (
            <>
              <line x1={X(t)} y1={mt} x2={X(t)} y2={mt + ph} stroke="var(--rule-soft)" />
              <text x={X(t)} y={mt + ph + 18} font-size="10.5" fill="var(--ink-faint)" text-anchor="middle">{t}</text>
            </>
          ))}
          {yticks.map((t) => (
            <>
              <line x1={ml} y1={Y(t)} x2={ml + pw} y2={Y(t)} stroke="var(--rule-soft)" />
              <text x={ml - 8} y={Y(t) + 4} font-size="10.5" fill="var(--ink-faint)" text-anchor="end">{t}</text>
            </>
          ))}
          <text x={ml + pw / 2} y={H - 6} font-size="11" fill="var(--ink-soft)" text-anchor="middle" letter-spacing="1">SECURITY % →</text>
          <text transform={`rotate(-90 12 ${mt + ph / 2})`} x="12" y={mt + ph / 2} font-size="11" fill="var(--ink-soft)" text-anchor="middle" letter-spacing="1">FIDELITY % →</text>

          {lines.map((line) => (
            <g class="reason-series" tabindex="0" role="img" aria-label={line.tip} data-tip={line.tip}>
              <path class="reason-hit" d={line.d} fill="none" stroke="transparent" stroke-width="14" />
              <path class="model-path" d={line.d} fill="none" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#arr)" />
              {line.points.map(([x, y]) => <circle cx={x} cy={y} r="3.2" fill="var(--card)" stroke="var(--ink-faint)" stroke-width="1.3" />)}
            </g>
          ))}

          <g class="reason-series average-series" tabindex="0" role="img" aria-label={average.tip} data-tip={average.tip}>
            <path class="reason-hit" d={average.d} fill="none" stroke="transparent" stroke-width="16" />
            <path class="average-path" d={average.d} fill="none" stroke="var(--ink)" stroke-width="3.5" marker-end="url(#avg-arr)" />
            {average.points.map(([x, y]) => <circle cx={x} cy={y} r="4.2" fill="var(--card)" stroke="var(--ink)" stroke-width="2.2" />)}
            <text x={average.points[3][0] + 8} y={average.points[3][1] - 9} font-size="11" font-weight="600" fill="var(--ink)">AVERAGE</text>
          </g>
        </svg>
      </div>
      <div class="reason-legend" aria-hidden="true">
        <span><i class="line individual"></i> Individual model</span>
        <span><i class="line average"></i> Seven-model average</span>
        <span>Reasoning effort from none to high</span>
      </div>
      <p class="reason-detail" role="status">Average security rises from 70.5% to 83.1%. Fidelity changes from 82.5% to 81.6%.</p>
      <figcaption>
        Seven hosted models at four reasoning levels. Higher effort mainly reduces
        execution and does not improve fidelity. Focus or hover on a trajectory to
        see its values.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .rchart svg { width: 100%; height: auto; }

  .reason-series { cursor: default; outline: none; }
  .model-path,
  .reason-series circle { transition: stroke 120ms ease, stroke-width 120ms ease, opacity 120ms ease; }
  .reason-series:hover .model-path,
  .reason-series:focus .model-path { stroke: var(--ink); stroke-width: 2.4; }
  .reason-series:hover circle,
  .reason-series:focus circle { stroke: var(--ink); }
  .average-series:hover .average-path,
  .average-series:focus .average-path { stroke-width: 4.5; }

  .reason-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    font-family: var(--font-body);
    font-size: var(--type-caption);
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }
  .reason-legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .reason-legend .line { width: 1.4rem; border-top: 2px solid var(--ink-faint); }
  .reason-legend .line.average { border-top: 4px solid var(--ink); }
  .reason-detail {
    min-height: 2.6rem;
    margin-top: 0.75rem;
    padding: 0.55rem 0.7rem;
    background: var(--paper);
    border-left: 3px solid var(--ink);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--type-data);
    line-height: var(--leading-compact);
  }

  @media (max-width: 40rem) {
    .rchart { overflow-x: auto; }
    .rchart svg { min-width: 32rem; }
  }
</style>

<script>
  const reasonChart = document.querySelector('[data-reason-chart]');
  if (reasonChart) {
    const detail = reasonChart.parentElement.querySelector('.reason-detail');
    const defaultText = detail.textContent;
    reasonChart.querySelectorAll('.reason-series').forEach((series) => {
      const show = () => { detail.textContent = series.dataset.tip; };
      const reset = () => { detail.textContent = defaultText; };
      series.addEventListener('pointerenter', show);
      series.addEventListener('focus', show);
      series.addEventListener('pointerleave', reset);
      series.addEventListener('blur', reset);
    });
  }
</script>
