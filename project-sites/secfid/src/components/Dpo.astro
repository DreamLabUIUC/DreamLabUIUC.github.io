---
import { dpo } from '../data/results.js';

const dpoRows = dpo.map((row) => ({
  ...row,
  fidelity: Number((100 - row.ignored).toFixed(1)),
  security: Number((100 - row.executed).toFixed(1)),
}));
---

<section class="section-rule" id="dpo">
  <div class="wrap split flip">
    <div class="split-copy">
      <h2>Targeted training recovers fidelity</h2>
      <p class="prose">
        Existing alignment defenses teach models not to obey injections. They do
        not teach models to preserve injected text when the task needs it. SecFid
        provides that signal by ranking <span class="mono">processed ≻ ignored ≻
        executed</span>.
      </p>
      <p class="prose">
        We fine-tuned the SecAlign checkpoint with DPO and tested it on a held-out
        editing task. <strong>Fidelity rose from 46.5% to 83.2%, while security
        remained above 99%.</strong> The result comes from one model, but it shows
        that training can shift the frontier.
      </p>
    </div>

    <figure class="plate reveal">
      <h3>Fidelity-aware DPO on held-out editing</h3>

      <div class="dot-head" aria-hidden="true">
        <span></span>
        <span class="metric-title fidelity-title">Fidelity</span>
        <span class="metric-title security-title">Security</span>
      </div>
      <div class="dpo-plot" role="img" aria-label="Fidelity and security for the base model, Defensive Tokens, SecAlign, and Fidelity-aware DPO on 273 held-out editing examples">
        {dpoRows.map((row) => (
          <div class="dpo-row">
            <span class="dname">{row.label}</span>
            <div class="metric-cell">
              <span class="mobile-label">Fidelity</span>
              <div class="dot-scale"><i class="dot fidelity" style={`--value:${row.fidelity}%`}></i></div>
              <b>{row.fidelity}%</b>
            </div>
            <div class="metric-cell">
              <span class="mobile-label">Security</span>
              <div class="dot-scale"><i class="dot security" style={`--value:${row.security}%`}></i></div>
              <b>{row.security}%</b>
            </div>
          </div>
        ))}
      </div>

      <figcaption>
        Held-out editing with n = 273. Training used no editing examples.
        Compared with SecAlign, fidelity-aware DPO raises fidelity from
        <strong>46.5% to 83.2%</strong>. Security moves from
        <strong>98.9% to 99.3%</strong>, and the processed rate rises from 43.2% to 80.6%.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  h3 { margin-bottom: 1.25rem; }

  .dot-head,
  .dpo-row {
    display: grid;
    grid-template-columns: minmax(8rem, 10.5rem) minmax(8rem, 1fr) minmax(8rem, 1fr);
    gap: 0.9rem;
    align-items: center;
  }
  .dot-head {
    margin-bottom: 0.45rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .fidelity-title { color: var(--proc); }
  .security-title { color: var(--security); }

  .dpo-plot { display: grid; gap: 0.35rem; }
  .dpo-row {
    min-height: 2.75rem;
    padding-block: 0.35rem;
    border-top: 1px solid var(--rule-soft);
  }
  .dpo-row:last-child {
    background: var(--proc-soft);
    border-top-color: transparent;
    border-radius: 3px;
    padding-inline: 0.55rem;
    margin-inline: -0.55rem;
  }
  .dname {
    font-family: var(--font-body);
    font-size: var(--type-caption);
    color: var(--ink-soft);
    line-height: 1.35;
  }
  .dpo-row:last-child .dname { color: var(--proc); font-weight: 600; }
  .metric-cell {
    display: grid;
    grid-template-columns: minmax(4rem, 1fr) 3.5rem;
    gap: 0.55rem;
    align-items: center;
  }
  .mobile-label { display: none; }
  .dot-scale {
    position: relative;
    height: 1.25rem;
  }
  .dot-scale::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 1px solid var(--rule);
  }
  .dot {
    position: absolute;
    top: 50%;
    left: clamp(0.35rem, var(--value), calc(100% - 0.35rem));
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--card);
  }
  .dot.fidelity { background: var(--proc); }
  .dot.security { background: var(--security); }
  .dpo-row:last-child .dot { box-shadow: 0 0 0 2px var(--proc-soft); }
  .metric-cell b {
    font-family: var(--font-mono);
    font-size: var(--type-data);
    text-align: right;
  }

  @media (max-width: 40rem) {
    .dot-head { display: none; }
    .dpo-row { grid-template-columns: 1fr; gap: 0.45rem; padding-block: 0.8rem; }
    .metric-cell { grid-template-columns: 5rem minmax(5rem, 1fr) 3.25rem; }
    .mobile-label {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--type-label);
      color: var(--ink-faint);
    }
  }
</style>
