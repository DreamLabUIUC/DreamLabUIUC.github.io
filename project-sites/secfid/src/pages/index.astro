---
import '@fontsource-variable/source-serif-4';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';

import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Separability from '../components/Separability.astro';
import Frontier from '../components/Frontier.astro';
import Mechanism from '../components/Mechanism.astro';
import Reasoning from '../components/Reasoning.astro';
import Dpo from '../components/Dpo.astro';
import Threshold from '../components/Threshold.astro';
import Use from '../components/Use.astro';
import Closing from '../components/Closing.astro';

const title = 'SecFid: The Hidden Cost of Prompt Injection Defense';
const description =
  'SecFid measures prompt-injection defense along two axes, security and fidelity. ' +
  'Across 1,168 examples and 48 configurations, the results reveal an empirical tradeoff.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="citation_title" content="Security--Fidelity Tradeoffs: The Hidden Cost of Prompt Injection Defense" />
    <meta name="citation_author" content="Mitchell Hermon" />
    <meta name="citation_author" content="Rahul Gupta" />
    <meta name="citation_author" content="Weitong Ruan" />
    <meta name="citation_author" content="Ekraam Sabir" />
    <meta name="citation_author" content="Haohan Wang" />
    <meta name="citation_publication_date" content="2026" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f1e7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#181410" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">Skip to main content</a>
    <Hero />
    <main id="content">
      <Problem />
      <Separability />
      <Frontier />
      <Mechanism />
      <Reasoning />
      <Dpo />
      <Threshold />
      <Use />
    </main>
    <Closing />

    <script>
      // reveal-on-scroll
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }),
          { threshold: 0.12 }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10;
    transform: translateY(-180%);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: var(--type-caption);
    font-weight: 600;
    padding: 0.55rem 0.8rem;
    border-radius: 3px;
  }
  .skip-link:focus { transform: none; }
</style>
